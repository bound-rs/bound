<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ title }}</title>
<style>
  body { font-family: system-ui, sans-serif; margin: 2rem; color: #1d1d1f; }
  table { border-collapse: collapse; }
  th, td { padding: 0.35rem 0.8rem; border-bottom: 1px solid #d2d2d7; text-align: left; }
  td.number, th.number { text-align: right; font-variant-numeric: tabular-nums; }
  tfoot td { font-weight: 600; border-bottom: none; }
</style>
</head>
<body>
<h1>{{ title }}</h1>
<table>
  <thead>
    <tr>{% for column in table.columns %}<th{% if column in table.totals %} class="number"{% endif %}>{{ column }}</th>{% endfor %}</tr>
  </thead>
  <tbody>
  {%- for row in table.rows %}
    <tr>{% for value in row %}<td{% if table.columns[loop.index0] in table.totals %} class="number"{% endif %}>{{ value }}</td>{% endfor %}</tr>
  {%- endfor %}
  </tbody>
  <tfoot>
    <tr>{% for column in table.columns %}<td{% if column in table.totals %} class="number"{% endif %}>{{ table.total(column) if loop.index0 else "Total" }}</td>{% endfor %}</tr>
  </tfoot>
</table>
<p>{{ table.rows | length }} rows</p>
</body>
</html>
